<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:componentes="clr-namespace:DemoTPI.Componentes"
             xmlns:entidades="clr-namespace:Dominio.Entidades;assembly=Dominio"
             xmlns:validaciones="clr-namespace:Dominio.Validaciones;assembly=Dominio"
             xmlns:vm="clr-namespace:DemoTPI.VIewModel"
             x:Class="DemoTPI.MainPage"
             x:DataType="vm:MainViewModel"
             Loaded="ContentPage_Loaded">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="15">

            <!-- Mismo componente CampoTexto, configurado distinto en cada uso -->
            <componentes:CampoTexto Titulo="Nombre" Texto="{Binding Nombre}" />
            <componentes:CampoTexto Titulo="Apellido" Texto="{Binding Apellido}" />
            <componentes:CampoTexto Titulo="Email"
                                    Texto="{Binding Email}"
                                    Placeholder="usuario@dominio.com"
                                    Teclado="Email"
                                    Patron="{x:Static validaciones:Validador.PatronEmail}"
                                    MensajeError="Formato: usuario@dominio.com" />
            <componentes:CampoTexto Titulo="Teléfono"
                                    Texto="{Binding Telefono}"
                                    Placeholder="11 4567-8901"
                                    Teclado="Telephone"
                                    Patron="{x:Static validaciones:Validador.PatronTelefono}"
                                    MensajeError="Formato: 11 4567-8901 o +54 9 11 4567 8901" />
            <componentes:CampoTexto Titulo="DNI"
                                    Texto="{Binding Dni}"
                                    Placeholder="12345678"
                                    Teclado="Numeric"
                                    Patron="{x:Static validaciones:Validador.PatronDni}"
                                    MensajeError="7 u 8 dígitos, con o sin puntos" />

            <componentes:BotonAceptar Text="Guardar" Command="{Binding GuardarCommand}" />

            <Label Text="{Binding Mensaje}" HorizontalOptions="Center" />

            <componentes:Lista Titulo="Estudiantes"
                               TextoVacio="Todavía no hay estudiantes cargados"
                               ItemsSource="{Binding ListadoEstudiantes}"
                               SelectedItem="{Binding EstudianteSeleccionado}">
                <componentes:Lista.ItemTemplate>
                    <DataTemplate x:DataType="entidades:Estudiante">
                        <VerticalStackLayout Padding="0,6">
                            <Label FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Apellido}" />
                                        <Span Text=", " />
                                        <Span Text="{Binding Nombre}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Email}" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </componentes:Lista.ItemTemplate>
            </componentes:Lista>

            <componentes:BotonConfirmar Text="Eliminar seleccionado"
                                        Pregunta="¿Eliminar el estudiante seleccionado?"
                                        ComandoConfirmado="{Binding EliminarCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
