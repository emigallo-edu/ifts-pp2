<?xml version="1.0" encoding="utf-8" ?>
<!-- Componente "de estilo": hereda de Button y sólo fija la apariencia.
     Conserva todo lo que Button ya tiene (Text, Command, Clicked...). -->
<Button xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="DemoTPI.Componentes.BotonAceptar"
        Text="Aceptar"
        BackgroundColor="{StaticResource Primary}"
        TextColor="{StaticResource White}"
        FontAttributes="Bold"
        CornerRadius="8"
        HorizontalOptions="Fill" />
