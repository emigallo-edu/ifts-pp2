<?xml version="1.0" encoding="utf-8" ?>
<!-- Componente compuesto: etiqueta + Entry + mensaje de error.
     Los bindings internos apuntan al propio control (x:Reference raiz), no al BindingContext
     del ContentView, porque ése lo hereda de la página que lo usa (el ViewModel). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:componentes="clr-namespace:DemoTPI.Componentes"
             x:Class="DemoTPI.Componentes.CampoTexto"
             x:Name="raiz">
    <VerticalStackLayout Spacing="4" x:DataType="componentes:CampoTexto" BindingContext="{x:Reference raiz}">
        <Label Text="{Binding Titulo}" FontAttributes="Bold" />
        <Entry Text="{Binding Texto}"
               Placeholder="{Binding Placeholder}"
               Keyboard="{Binding Teclado}" />
        <Label Text="{Binding MensajeError}"
               IsVisible="{Binding MostrarError}"
               TextColor="Red"
               FontSize="12" />
    </VerticalStackLayout>
</ContentView>
